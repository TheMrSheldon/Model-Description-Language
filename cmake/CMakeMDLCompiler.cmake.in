set(CMAKE_MDL_COMPILER "@CMAKE_MDL_COMPILER@" )
set(CMAKE_MDL_COMPILER_LOADED 1)
set(CMAKE_MDL_SOURCE_FILE_EXTENSIONS @CMAKE_MDL_SOURCE_FILE_EXTENSIONS@ )
set(CMAKE_MDL_OUTPUT_EXTENSION @CMAKE_MDL_OUTPUT_EXTENSION@ )
set(CMAKE_MDL_COMPILER_ENV_VAR "@CMAKE_MDL_COMPILER_ENV_VAR@" )

define_property(TARGET
    PROPERTY MDL_ARGVALS
    BRIEF_DOCS "Sets the path to a YAML file that contains the argument instantiations."
    FULL_DOCS  "Sets the path to a YAML file that contains the argument instantiations."
)

function(target_mdl_argvals tgt)
    set_property(TARGET ${tgt} PROPERTY MDL_ARGVALS "${ARGN}")

    target_compile_options(${tgt}  PRIVATE
        $<$<BOOL:$<TARGET_PROPERTY:MDL_ARGVALS>>:-a>
        $<$<BOOL:$<TARGET_PROPERTY:MDL_AMDL_ARGVALSRGUMENTS>>:$<TARGET_PROPERTY:MDL_ARGVALS>>
    )
endfunction()