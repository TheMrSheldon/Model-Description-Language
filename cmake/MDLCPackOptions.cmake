# Read by CPack for each generator (CPACK_PROJECT_CONFIG_FILE, see Packaging.cmake): the settings that differ between the
# generators. CPACK_GENERATOR is the current one; the CPACK_MDL_* variables are set by Packaging.cmake.
#
# The editor archive: `cpack -G TGZ -D CPACK_MDL_ARCHIVE=tools` (ZIP on Windows) packs only the tools as
# mdl-tools-<platform>.{tar.gz,zip} with the layout bin/, share/mdl/std/ that the editor integration downloads.
set(_components ${CPACK_MDL_COMPONENTS})

# The package names: mdl (the meta package), mdl-tools, mdl-runtime, mdl-compiler, mdl-sdk, mdl-cuda.
function(_mdl_package_name var component)
	if(component STREQUAL "mdl")
		set(${var} "mdl" PARENT_SCOPE)
	else()
		set(${var} "mdl-${component}" PARENT_SCOPE)
	endif()
endfunction()

# The dependencies of the components (names of other components); the meta package needs all but cuda.
set(_needs_tools "")
set(_needs_runtime "")
set(_needs_compiler tools runtime)
set(_needs_sdk runtime)
set(_needs_cuda compiler sdk)
set(_needs_mdl tools compiler sdk)

if(CPACK_GENERATOR STREQUAL "DEB")
	set(CPACK_PACKAGING_INSTALL_PREFIX "/usr")
	set(CPACK_DEB_COMPONENT_INSTALL ON)
	set(CPACK_DEBIAN_FILE_NAME DEB-DEFAULT)
	set(CPACK_DEBIAN_PACKAGE_VERSION "${CPACK_MDL_DEB_VERSION}")
	set(CPACK_DEBIAN_PACKAGE_SECTION "devel")
	# The architecture of the target, not of the machine that packages (it need not have dpkg).
	if(CPACK_MDL_PLATFORM MATCHES "arm64$")
		set(CPACK_DEBIAN_PACKAGE_ARCHITECTURE "arm64")
	else()
		set(CPACK_DEBIAN_PACKAGE_ARCHITECTURE "amd64")
	endif()
	# The libraries are private (lib/mdl, found through RPATH): no automatic dependencies on them.
	set(CPACK_DEBIAN_PACKAGE_SHLIBDEPS OFF)
	foreach(component IN LISTS _components)
		_mdl_package_name(name ${component})
		string(TOUPPER "${component}" COMPONENT)
		set(CPACK_DEBIAN_${COMPONENT}_PACKAGE_NAME "${name}")
		set(depends "libc6 (>= 2.28)")
		if(component STREQUAL "runtime")
			list(APPEND depends "libgomp1")
		endif()
		foreach(need IN LISTS _needs_${component})
			if(need IN_LIST _components)
				_mdl_package_name(needed ${need})
				list(APPEND depends "${needed} (= ${CPACK_MDL_DEB_VERSION})")
			endif()
		endforeach()
		if(component STREQUAL "mdl")
			set(depends "")
			foreach(need IN LISTS _needs_mdl)
				if(need IN_LIST _components)
					_mdl_package_name(needed ${need})
					list(APPEND depends "${needed} (= ${CPACK_MDL_DEB_VERSION})")
				endif()
			endforeach()
			if("cuda" IN_LIST _components)
				set(CPACK_DEBIAN_MDL_PACKAGE_SUGGESTS "mdl-cuda")
			endif()
		endif()
		list(JOIN depends ", " depends)
		set(CPACK_DEBIAN_${COMPONENT}_PACKAGE_DEPENDS "${depends}")
	endforeach()
	set(CPACK_DEBIAN_CUDA_PACKAGE_SUGGESTS "cuda-toolkit | nvidia-cuda-toolkit")
	set(CPACK_DEBIAN_MDL_PACKAGE_DESCRIPTION "${CPACK_PACKAGE_DESCRIPTION_SUMMARY} (metapackage: tools, compiler, and SDK)")
elseif(CPACK_GENERATOR STREQUAL "RPM")
	set(CPACK_PACKAGING_INSTALL_PREFIX "/usr")
	set(CPACK_RPM_COMPONENT_INSTALL ON)
	set(CPACK_RPM_FILE_NAME RPM-DEFAULT)
	set(CPACK_RPM_PACKAGE_VERSION "${CPACK_MDL_RPM_VERSION}")
	set(CPACK_RPM_PACKAGE_RELEASE "${CPACK_MDL_RPM_RELEASE}")
	set(CPACK_RPM_PACKAGE_LICENSE "Apache-2.0")
	set(CPACK_RPM_PACKAGE_GROUP "Development/Languages")
	if(CPACK_MDL_PLATFORM MATCHES "arm64$")
		set(CPACK_RPM_PACKAGE_ARCHITECTURE "aarch64")
	else()
		set(CPACK_RPM_PACKAGE_ARCHITECTURE "x86_64")
	endif()
	# The libraries are private (lib/mdl): no automatic dependencies on them, and they do not provide anything.
	set(CPACK_RPM_PACKAGE_AUTOREQ OFF)
	set(CPACK_RPM_PACKAGE_AUTOPROV OFF)
	set(CPACK_RPM_DEBUGINFO_PACKAGE OFF)
	foreach(component IN LISTS _components)
		_mdl_package_name(name ${component})
		string(TOUPPER "${component}" COMPONENT)
		set(CPACK_RPM_${COMPONENT}_PACKAGE_NAME "${name}")
		set(requires "")
		if(component STREQUAL "runtime")
			list(APPEND requires "libgomp.so.1()(64bit)")
		endif()
		foreach(need IN LISTS _needs_${component})
			if(need IN_LIST _components)
				_mdl_package_name(needed ${need})
				list(APPEND requires "${needed} = ${CPACK_MDL_RPM_VERSION}-${CPACK_MDL_RPM_RELEASE}")
			endif()
		endforeach()
		list(JOIN requires ", " requires)
		if(requires)
			set(CPACK_RPM_${COMPONENT}_PACKAGE_REQUIRES "${requires}")
		endif()
	endforeach()
	if("cuda" IN_LIST _components)
		set(CPACK_RPM_MDL_PACKAGE_SUGGESTS "mdl-cuda")
	endif()
	set(CPACK_RPM_MDL_PACKAGE_SUMMARY "${CPACK_PACKAGE_DESCRIPTION_SUMMARY} (metapackage)")
elseif(CPACK_GENERATOR STREQUAL "productbuild")
	# A .pkg with a choice of components (the installer's customize page). It is not signed: macOS asks the user to
	# confirm opening it (right-click, Open).
	set(CPACK_PACKAGING_INSTALL_PREFIX "/usr/local")
	set(CPACK_PRODUCTBUILD_IDENTIFIER "io.github.themrsheldon.mdl")
	set(CPACK_COMPONENTS_GROUPING IGNORE)
elseif(CPACK_GENERATOR STREQUAL "NSIS")
	set(CPACK_NSIS_PACKAGE_NAME "MDL")
	set(CPACK_NSIS_DISPLAY_NAME "MDL ${CPACK_PACKAGE_VERSION}")
	set(CPACK_NSIS_INSTALL_ROOT "$PROGRAMFILES64")
	set(CPACK_NSIS_URL_INFO_ABOUT "${CPACK_PACKAGE_HOMEPAGE_URL}")
	set(CPACK_NSIS_HELP_LINK "${CPACK_PACKAGE_HOMEPAGE_URL}")
	set(CPACK_NSIS_MODIFY_PATH ON) # offers to add bin to the PATH
	set(CPACK_NSIS_ENABLE_UNINSTALL_BEFORE_INSTALL ON)
	set(CPACK_NSIS_COMPRESSOR "/SOLID lzma")
endif()

# The editor archive: the tools only, in the directory mdl-tools-<platform> (as the archives of earlier releases).
if(CPACK_MDL_ARCHIVE STREQUAL "tools" AND CPACK_GENERATOR MATCHES "^(TGZ|ZIP)$")
	set(CPACK_INSTALL_CMAKE_PROJECTS "${CPACK_MDL_BINARY_DIR};mdl;tools;/")
	set(CPACK_PACKAGE_FILE_NAME "mdl-tools-${CPACK_MDL_PLATFORM}")
endif()
