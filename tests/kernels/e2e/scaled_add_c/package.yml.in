# The end-to-end test package: `2 * x + y` as a C function (built by tests/kernels/e2e/CMakeLists.txt).
schema: 1
package: scaled_add_c
version: "1.0"

artifacts:
  host:
    kind: static-library
    path: @MDL_KERNEL_ARTIFACT@
    platform: { os: @MDL_KERNEL_OS@, arch: @MDL_KERNEL_ARCH@, abi: @MDL_KERNEL_ABI@ }

patterns:
  scaled-add:
    op: relax.add
    args:
      - op: relax.multiply
        args: [{ capture: x }, { const: 2.0 }]
      - { capture: y }
  scaled3-add:
    op: relax.add
    args:
      - op: relax.multiply
        args: [{ capture: x }, { const: 3.0 }]
      - { capture: y }

implementations:
  scaled-add-f32:
    pattern: scaled-add
    artifacts: [host]
    priority: 10
    symbol: test_scaled_add_f32
    signature:
      returns: { type: int32, error: nonzero }
      arguments:
        - { type: pointer, access: write, value: $out.data }
        - { type: pointer, access: read, value: $x.data }
        - { type: pointer, access: read, value: $y.data }
        - { type: int64, value: "prod($x.shape)" }
      outputs:
        - { shape: $x.shape, dtype: $x.dtype }
    applicability:
      dtype: { x: float32, y: float32 }
      layout: { x: row-major, y: row-major }
      where: ["$x.shape == $y.shape"]
  scaled3-add-even:   # a runtime guard: the batch size is symbolic (TVM's code for odd batch sizes)
    pattern: scaled3-add
    artifacts: [host]
    priority: 10
    symbol: test_scaled3_add_even_f32
    signature:
      returns: { type: int32, error: nonzero }
      arguments:
        - { type: pointer, access: write, value: $out.data }
        - { type: pointer, access: read, value: $x.data }
        - { type: pointer, access: read, value: $y.data }
        - { type: int64, value: "prod($x.shape)" }
      outputs:
        - { shape: $x.shape, dtype: $x.dtype }
    applicability:
      dtype: { x: float32, y: float32 }
      where: ["$x.shape == $y.shape", "$x.shape[0] % 2 == 0"]
