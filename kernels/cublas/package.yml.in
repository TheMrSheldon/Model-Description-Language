# The cuBLAS kernels (library mdl_cublas: kernels/cublas/src, C ABI in kernels/cublas/include/mdl_cublas.h).
# Generated by kernels/CMakeLists.txt: the build tree's libraries, or (installed) lib/ of the package.
schema: 1
package: cublas
version: "@MDL_CUBLAS_VERSION@-mdl1"
description: cuBLAS kernels for CUDA targets (matrix products with bias, scale, GELU and addend; cuBLASLt).

artifacts:
  mdl-kernels:
    kind: static-library
    path: $<TARGET_FILE:mdl_cublas>
    platform: { os: @MDL_KERNEL_OS@, arch: @MDL_KERNEL_ARCH@, abi: @MDL_KERNEL_ABI@ }
    # The oldest GPU architecture the library is built for (MDL_CUBLAS_ARCHITECTURES); it also contains PTX.
    device-arch: @MDL_CUBLAS_DEVICE_ARCH@
    dependencies:
      - { kind: system-library, name: cublasLt }
      - { kind: system-library, name: cublas }
      - { kind: system-library, name: cudart }

patterns:
  matmul:   # mdl.matmul: permutations, bias, scale, activation and addend (see the legalizer's MatmulArgs)
    op: mdl.matmul
    args:
      - { capture: a }
      - { capture: b }
      - { capture: bias }
      - { capture: perm_a }
      - { capture: perm_b }
      - { capture: perm_out }
      - { capture: alpha }
      - { capture: activation }
      - { capture: addend }
      - { capture: scales }
      - { capture: zeros }
      - { capture: quant }

implementations:
  # Matrix products of strided views (the ABI of the oneDNN package's mdl_matmul_<type>): the operands in the product's
  # logical layout (the permutations of mdl.matmul applied to their shapes and strides).
  matmul-f32: &matmul
    pattern: matmul
    artifacts: [mdl-kernels]
    priority: 100
    symbol: mdl_cublas_matmul_f32
    signature:
      returns: { type: int32, error: nonzero }
      arguments:
        - { type: pointer, access: write, value: $out.data }
        - { type: pointer, access: read, value: $a.data }
        - { type: pointer, access: read, value: $b.data }
        - { type: pointer, access: read, value: $bias.data }     # (NULL without a bias)
        - { type: pointer, access: read, value: $addend.data }   # (NULL without an addend)
        - { type: int64, value: $a.ndim }
        - { type: "int64[]", value: "permute($a.shape, $perm_a.values)" }
        - { type: "int64[]", value: "permute(strides($a.shape), $perm_a.values)" }
        - { type: int64, value: $b.ndim }
        - { type: "int64[]", value: "permute($b.shape, $perm_b.values)" }
        - { type: "int64[]", value: "permute(strides($b.shape), $perm_b.values)" }
        - { type: int64, value: $out.ndim }
        - { type: "int64[]", value: "unpermute($out.shape, $perm_out.values)" }
        - { type: "int64[]", value: "unpermute(strides($out.shape), $perm_out.values)" }
        - { type: int32, value: $activation.value }
        - { type: float32, value: $alpha.real }
    applicability:
      dtype: { a: float32 }
      where: &matmul-where
        - "not $scales.is_tensor"   # (no quantized weights)
        - "not $addend.is_tensor or $addend.shape == $out.shape"
        # cuBLAS reads matrices with a unit stride in one of their two dimensions.
        - "1 in permute(strides($a.shape), $perm_a.values)[-2:]"
        - "1 in permute(strides($b.shape), $perm_b.values)[-2:]"
        - "1 in unpermute(strides($out.shape), $perm_out.values)[-2:]"
  matmul-bf16:
    <<: *matmul
    symbol: mdl_cublas_matmul_bf16
    applicability: { dtype: { a: bfloat16 }, where: *matmul-where }
  matmul-f16:
    <<: *matmul
    symbol: mdl_cublas_matmul_f16
    applicability: { dtype: { a: float16 }, where: *matmul-where }
