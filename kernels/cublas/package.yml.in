# The cuBLAS kernels (library mdl_cublas: kernels/cublas/src, C ABI in kernels/cublas/include/mdl_cublas.h).
# Generated by kernels/CMakeLists.txt: the build tree's libraries, or (installed) lib/ of the package.
schema: 1
package: cublas
version: "@MDL_CUBLAS_VERSION@-mdl1"
description: cuBLAS kernels for CUDA targets (matrix products with bias, scale, GELU and addend).

artifacts:
  mdl-kernels:
    kind: static-library
    path: $<TARGET_FILE:mdl_cublas>
    platform: { os: @MDL_KERNEL_OS@, arch: @MDL_KERNEL_ARCH@, abi: @MDL_KERNEL_ABI@ }
    # The oldest GPU architecture the library is built for (MDL_CUBLAS_ARCHITECTURES); it also contains PTX.
    device-arch: @MDL_CUBLAS_DEVICE_ARCH@
    dependencies:
      - { kind: system-library, name: cublas }
      - { kind: system-library, name: cudart }

patterns:
  matmul:   # mdl.matmul: permutations, bias, scale, activation and addend (see the legalizer's MatmulArgs)
    op: mdl.matmul
    args:
      - { capture: a }
      - { capture: b }
      - { capture: bias }
      - { capture: perm_a }
      - { capture: perm_b }
      - { capture: perm_out }
      - { capture: alpha }
      - { capture: activation }
      - { capture: addend }
      - { capture: scales }
      - { capture: zeros }
      - { capture: quant }
  relax-matmul:
    op: relax.matmul
    args: [{ capture: a }, { capture: b }]

implementations:
  # The ABI of the oneDNN package's mdl_matmul_<type>: the same adapter computes the arguments.
  matmul-f32: &matmul
    pattern: matmul
    artifacts: [mdl-kernels]
    priority: 100
    symbol: mdl_cublas_matmul_f32
    adapter: matmul-strided
    applicability:
      dtype: { a: float32 }
  matmul-bf16:
    <<: *matmul
    symbol: mdl_cublas_matmul_bf16
    applicability: { dtype: { a: bfloat16 } }
  matmul-f16:
    <<: *matmul
    symbol: mdl_cublas_matmul_f16
    applicability: { dtype: { a: float16 } }
  relax-matmul-f32:
    <<: *matmul
    pattern: relax-matmul
  relax-matmul-bf16:
    <<: *matmul
    pattern: relax-matmul
    symbol: mdl_cublas_matmul_bf16
    applicability: { dtype: { a: bfloat16 } }
  relax-matmul-f16:
    <<: *matmul
    pattern: relax-matmul
    symbol: mdl_cublas_matmul_f16
    applicability: { dtype: { a: float16 } }
