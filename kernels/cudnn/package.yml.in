# The cuDNN kernels (library mdl_cudnn: kernels/cudnn/src, C ABI in kernels/cudnn/include/mdl_cudnn.h).
# Generated by kernels/CMakeLists.txt: the build tree's libraries, or (installed) lib/ of the package.
schema: 1
package: cudnn
version: "@MDL_CUDNN_VERSION@-mdl1"
description: cuDNN kernels for CUDA targets (fused attention).

artifacts:
  mdl-kernels:
    kind: static-library
    path: $<TARGET_FILE:mdl_cudnn>
    platform: { os: @MDL_KERNEL_OS@, arch: @MDL_KERNEL_ARCH@, abi: @MDL_KERNEL_ABI@ }
    device-arch: sm_80 # cuDNN's fused attention: Ampere and newer
    dependencies:
      - { kind: system-library, name: cudnn }
      - { kind: system-library, name: cudart }

patterns:
  attention:   # softmax(scale * Q @ K^T) @ V, the scores and probabilities used nowhere else
    op: mdl.matmul
    args:
      - op: relax.nn.softmax
        attrs: { axis: -1 }
        args:
          - op: mdl.matmul
            capture: scores
            args:
              - { capture: q }
              - { capture: k }
              - { capture: scores_bias }
              - { capture: perm_q }
              - { capture: perm_k }
              - { capture: perm_scores }
              - { capture: scale }
              - { capture: scores_activation }
              - { capture: scores_addend }
              - { capture: scores_scales }
              - { capture: scores_zeros }
              - { capture: scores_quant }
      - { capture: v }
      - { capture: bias }
      - { capture: perm_p }
      - { capture: perm_v }
      - { capture: perm_out }
      - { capture: alpha }
      - { capture: activation }
      - { capture: addend }
      - { capture: scales }
      - { capture: zeros }
      - { capture: quant }

implementations:
  attention-bf16: &attention
    pattern: attention
    artifacts: [mdl-kernels]
    priority: 200   # (over the separate products of the cuBLAS package)
    symbol: mdl_attention_bf16
    adapter: attention-strided
    applicability:
      dtype: { q: bfloat16 }
  attention-f16:
    <<: *attention
    symbol: mdl_attention_f16
    applicability: { dtype: { q: float16 } }
