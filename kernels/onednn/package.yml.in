# The oneDNN kernels of mdl_kernels (src/mdl/runtime/kernels/onednn.cpp, C ABI in include/mdl/runtime/kernels.h).
# Generated by kernels/CMakeLists.txt: the libraries are the build's mdl_kernels and oneDNN.
schema: 1
package: onednn
version: "3.13.4-mdl1"
description: oneDNN kernels (softmax; the others follow).

artifacts:
  mdl-kernels:
    kind: static-library
    path: $<TARGET_FILE:mdl_kernels>
    platform: { os: @MDL_KERNEL_OS@, arch: @MDL_KERNEL_ARCH@, abi: @MDL_KERNEL_ABI@ }
    dependencies:
      - { kind: artifact, name: dnnl }
      - { kind: runtime, name: openmp }
  dnnl:
    kind: static-library
    path: $<TARGET_FILE:dnnl>
    platform: { os: @MDL_KERNEL_OS@, arch: @MDL_KERNEL_ARCH@, abi: @MDL_KERNEL_ABI@ }
    dependencies:
      - { kind: runtime, name: openmp }

patterns:
  softmax:   # softmax over the last axis
    op: relax.nn.softmax
    args: [{ capture: x }]
    attrs: { axis: -1 }

implementations:
  softmax-f32: &softmax
    pattern: softmax
    artifacts: [mdl-kernels]
    priority: 100
    symbol: mdl_softmax_f32
    signature:
      returns: { type: int32, error: nonzero }
      arguments:
        - { type: pointer, access: write, value: $out.data }
        - { type: pointer, access: read, value: $x.data }
        - { type: int64, value: "prod($x.shape[:-1])" }
        - { type: int64, value: "$x.shape[-1]" }
      outputs:
        - { shape: $x.shape, dtype: $x.dtype }
    applicability:
      dtype: { x: float32 }
      layout: { x: row-major }
  softmax-bf16:
    <<: *softmax
    symbol: mdl_softmax_bf16
    applicability:
      dtype: { x: bfloat16 }
      layout: { x: row-major }
  softmax-f16:
    <<: *softmax
    symbol: mdl_softmax_f16
    applicability:
      dtype: { x: float16 }
      layout: { x: row-major }
