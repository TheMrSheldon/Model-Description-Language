# The oneDNN kernels (mdl_kernels: src/mdl/runtime/kernels/onednn.cpp, C ABI in include/mdl/runtime/kernels.h).
# Generated by kernels/CMakeLists.txt: the build tree's libraries, or (installed) lib/ of the package.
schema: 1
package: onednn
version: "3.13.4-mdl1"
description: oneDNN kernels (matrix products, softmax, gelu, layer norm and its gradient, column sums).

artifacts:
  mdl-kernels:
    kind: static-library
    path: $<TARGET_FILE:mdl_kernels>
    platform: { os: @MDL_KERNEL_OS@, arch: @MDL_KERNEL_ARCH@, abi: @MDL_KERNEL_ABI@ }
    dependencies:
      - { kind: artifact, name: dnnl }
      - { kind: runtime, name: openmp }
  dnnl:
    kind: static-library
    path: $<TARGET_FILE:dnnl>
    platform: { os: @MDL_KERNEL_OS@, arch: @MDL_KERNEL_ARCH@, abi: @MDL_KERNEL_ABI@ }
    dependencies:
      - { kind: runtime, name: openmp }

patterns:
  softmax:   # softmax over the last axis
    op: relax.nn.softmax
    args: [{ capture: x }]
    attrs: { axis: -1 }
  gelu:
    op: relax.nn.gelu
    args: [{ capture: x }]
  gelu-backward:
    op: mdl.gelu_backward
    args: [{ capture: x }, { capture: dy }]
  layer-norm:   # over the last axis, with scale and shift
    op: relax.nn.layer_norm
    args: [{ capture: x }, { capture: gamma }, { capture: beta }]
    attrs: { axes: [-1], center: true, scale: true }
  matmul:   # mdl.matmul: permutations, bias, scale, activation and addend (see the legalizer's MatmulArgs)
    op: mdl.matmul
    args:
      - { capture: a }
      - { capture: b }
      - { capture: bias }
      - { capture: perm_a }
      - { capture: perm_b }
      - { capture: perm_out }
      - { capture: alpha }
      - { capture: activation }
      - { capture: addend }
      - { capture: scales }
      - { capture: zeros }
      - { capture: quant }
  relax-matmul:
    op: relax.matmul
    args: [{ capture: a }, { capture: b }]
  layer-norm-backward:   # the input's gradient of a layer norm as MDL's autodiff writes it: rsqrt(var) *
    # (g - mean(g) - xhat * mean(g * xhat)), g = dy * gamma (xhat: the normalized input, var: the variance + eps)
    op: relax.multiply
    args:
      - { op: relax.rsqrt, args: [{ capture: var }] }
      - op: relax.subtract
        args:
          - op: relax.subtract
            args:
              - { op: relax.multiply, capture: g, args: [{ capture: dy }, { capture: gamma }] }
              - { op: relax.reshape, args: [{ op: relax.divide, args: [{ op: relax.sum, args: [{ capture: g }], attrs: { axis: [-1], keepdims: false } }, { const: "$dy.shape[-1]" }] }, { capture: shape1 }] }
          - op: relax.multiply
            args:
              - { capture: xhat }
              - { op: relax.reshape, args: [{ op: relax.divide, args: [{ op: relax.sum, args: [{ op: relax.multiply, args: [{ capture: g }, { capture: xhat }] }], attrs: { axis: [-1], keepdims: false } }, { const: "$dy.shape[-1]" }] }, { capture: shape2 }] }
  layer-norm-backward-16:   # the same in a 16-bit type (the sums in float32)
    op: relax.multiply
    args:
      - { op: relax.rsqrt, args: [{ capture: var }] }
      - op: relax.subtract
        args:
          - op: relax.subtract
            args:
              - { op: relax.multiply, capture: g, args: [{ capture: dy }, { capture: gamma }] }
              - { op: relax.reshape, args: [{ op: relax.divide, args: [{ op: relax.astype, args: [{ op: relax.sum, args: [{ op: relax.astype, args: [{ capture: g }] }], attrs: { axis: [-1], keepdims: false } }] }, { const: "$dy.shape[-1]" }] }, { capture: shape1 }] }
          - op: relax.multiply
            args:
              - { capture: xhat }
              - { op: relax.reshape, args: [{ op: relax.divide, args: [{ op: relax.astype, args: [{ op: relax.sum, args: [{ op: relax.astype, args: [{ op: relax.multiply, args: [{ capture: g }, { capture: xhat }] }] }], attrs: { axis: [-1], keepdims: false } }] }, { const: "$dy.shape[-1]" }] }, { capture: shape2 }] }
  sum-rows:   # (not of a product, e.g. the gradient of LayerNorm's scale: TVM fuses that with the product)
    op: relax.collapse_sum_to
    args: [{ capture: x, not: relax.multiply }, { capture: shape }]

implementations:
  softmax-f32: &softmax
    pattern: softmax
    artifacts: [mdl-kernels]
    priority: 100
    symbol: mdl_softmax_f32
    signature:
      returns: { type: int32, error: nonzero }
      arguments:
        - { type: pointer, access: write, value: $out.data }
        - { type: pointer, access: read, value: $x.data }
        - { type: int64, value: "prod($x.shape[:-1])" }
        - { type: int64, value: "$x.shape[-1]" }
      outputs:
        - { shape: $x.shape, dtype: $x.dtype }
    applicability:
      dtype: { x: float32 }
      layout: { x: row-major }
  softmax-bf16:
    <<: *softmax
    symbol: mdl_softmax_bf16
    applicability:
      dtype: { x: bfloat16 }
      layout: { x: row-major }
  softmax-f16:
    <<: *softmax
    symbol: mdl_softmax_f16
    applicability:
      dtype: { x: float16 }
      layout: { x: row-major }
  gelu-f32: &gelu
    pattern: gelu
    artifacts: [mdl-kernels]
    priority: 100
    symbol: mdl_gelu_f32
    signature:
      returns: { type: int32, error: nonzero }
      arguments:
        - { type: pointer, access: write, value: $out.data }
        - { type: pointer, access: read, value: $x.data }
        - { type: int64, value: "prod($x.shape)" }
      outputs:
        - { shape: $x.shape, dtype: $x.dtype }
    applicability:
      dtype: { x: float32 }
      layout: { x: row-major }
  gelu-bf16:
    <<: *gelu
    symbol: mdl_gelu_bf16
    applicability: { dtype: { x: bfloat16 }, layout: { x: row-major } }
  gelu-f16:
    <<: *gelu
    symbol: mdl_gelu_f16
    applicability: { dtype: { x: float16 }, layout: { x: row-major } }

  gelu-backward-f32: &gelu-backward
    pattern: gelu-backward
    artifacts: [mdl-kernels]
    priority: 100
    symbol: mdl_gelu_backward_f32
    signature:
      returns: { type: int32, error: nonzero }
      arguments:
        - { type: pointer, access: write, value: $out.data }
        - { type: pointer, access: read, value: $x.data }
        - { type: pointer, access: read, value: $dy.data }
        - { type: int64, value: "prod($dy.shape)" }
      outputs:
        - { shape: $dy.shape, dtype: $dy.dtype }
    applicability:
      dtype: { x: float32, dy: float32 }
      layout: { x: row-major, dy: row-major }
      where: ["$x.shape == $dy.shape"]
  gelu-backward-bf16:
    <<: *gelu-backward
    symbol: mdl_gelu_backward_bf16
    applicability:
      dtype: { x: bfloat16, dy: bfloat16 }
      layout: { x: row-major, dy: row-major }
      where: ["$x.shape == $dy.shape"]
  gelu-backward-f16:
    <<: *gelu-backward
    symbol: mdl_gelu_backward_f16
    applicability:
      dtype: { x: float16, dy: float16 }
      layout: { x: row-major, dy: row-major }
      where: ["$x.shape == $dy.shape"]

  layer-norm-f32: &layer-norm
    pattern: layer-norm
    artifacts: [mdl-kernels]
    priority: 100
    symbol: mdl_layer_norm_f32
    signature:
      returns: { type: int32, error: nonzero }
      arguments:
        - { type: pointer, access: write, value: $out.data }
        - { type: pointer, access: read, value: $x.data }
        - { type: pointer, access: read, value: $gamma.data }
        - { type: pointer, access: read, value: $beta.data }
        - { type: int64, value: "prod($x.shape[:-1])" }
        - { type: int64, value: "$x.shape[-1]" }
        - { type: float32, value: "$out.attr.epsilon" }
      outputs:
        - { shape: $x.shape, dtype: $x.dtype }
    applicability:
      dtype: { x: float32, gamma: float32, beta: float32 }
      layout: { x: row-major }
  layer-norm-bf16:
    <<: *layer-norm
    symbol: mdl_layer_norm_bf16
    applicability:
      dtype: { x: bfloat16, gamma: bfloat16, beta: bfloat16 }
      layout: { x: row-major }
  layer-norm-f16:
    <<: *layer-norm
    symbol: mdl_layer_norm_f16
    applicability:
      dtype: { x: float16, gamma: float16, beta: float16 }
      layout: { x: row-major }

  sum-rows-f32: &sum-rows   # column sums over the leading dimensions, e.g. the gradient of a bias
    pattern: sum-rows
    artifacts: [mdl-kernels]
    priority: 100
    symbol: mdl_sum_rows_f32
    signature:
      returns: { type: int32, error: nonzero }
      arguments:
        - { type: pointer, access: write, value: $out.data }
        - { type: pointer, access: read, value: $x.data }
        - { type: int64, value: "prod($x.shape[:-1])" }
        - { type: int64, value: "$x.shape[-1]" }
    applicability:
      dtype: { x: float32 }
      layout: { x: row-major }
      where: ["$x.ndim > 1", "$out.ndim == 1", "$out.shape[0] == $x.shape[-1]"]
  sum-rows-bf16:
    <<: *sum-rows
    symbol: mdl_sum_rows_bf16
    applicability:
      dtype: { x: bfloat16 }
      layout: { x: row-major }
      where: ["$x.ndim > 1", "$out.ndim == 1", "$out.shape[0] == $x.shape[-1]"]
  sum-rows-f16:
    <<: *sum-rows
    symbol: mdl_sum_rows_f16
    applicability:
      dtype: { x: float16 }
      layout: { x: row-major }
      where: ["$x.ndim > 1", "$out.ndim == 1", "$out.shape[0] == $x.shape[-1]"]

  # Matrix products: the adapters compute the strided views (see docs/kernels.md, adapters).
  matmul-f32: &matmul
    pattern: matmul
    artifacts: [mdl-kernels]
    priority: 100
    symbol: mdl_matmul_f32
    adapter: matmul-strided
    applicability:
      dtype: { a: float32 }
  matmul-bf16:
    <<: *matmul
    symbol: mdl_matmul_bf16
    applicability: { dtype: { a: bfloat16 } }
  matmul-f16:
    <<: *matmul
    symbol: mdl_matmul_f16
    applicability: { dtype: { a: float16 } }
  relax-matmul-f32:
    <<: *matmul
    pattern: relax-matmul
  relax-matmul-bf16:
    <<: *matmul
    pattern: relax-matmul
    symbol: mdl_matmul_bf16
    applicability: { dtype: { a: bfloat16 } }
  relax-matmul-f16:
    <<: *matmul
    pattern: relax-matmul
    symbol: mdl_matmul_f16
    applicability: { dtype: { a: float16 } }
  matmul-quantized-f32: &matmul-quantized   # quantized weights (a linear layer)
    <<: *matmul
    symbol: mdl_matmul_q_f32
    adapter: matmul-quantized
  matmul-quantized-bf16:
    <<: *matmul-quantized
    symbol: mdl_matmul_q_bf16
    applicability: { dtype: { a: bfloat16 } }
  matmul-quantized-f16:
    <<: *matmul-quantized
    symbol: mdl_matmul_q_f16
    applicability: { dtype: { a: float16 } }

  layer-norm-backward-f32: &layer-norm-backward
    pattern: layer-norm-backward
    artifacts: [mdl-kernels]
    priority: 100
    symbol: mdl_layer_norm_backward_f32
    signature:
      returns: { type: int32, error: nonzero }
      arguments:
        - { type: pointer, access: write, value: $out.data }
        - { type: pointer, access: read, value: $dy.data }
        - { type: pointer, access: read, value: $gamma.data }
        - { type: pointer, access: read, value: $xhat.data }
        - { type: pointer, access: read, value: $var.data }
        - { type: int64, value: "prod($dy.shape[:-1])" }
        - { type: int64, value: "$dy.shape[-1]" }
      outputs:
        - { shape: $dy.shape, dtype: $dy.dtype }
    applicability:
      dtype: { dy: float32, gamma: float32, xhat: float32, var: float32 }
      layout: { dy: row-major, xhat: row-major, var: row-major }
      where:
        - "$xhat.shape == $dy.shape"
        - "$gamma.shape == $dy.shape[-1:]"
        - "prod($var.shape) == prod($dy.shape[:-1])"
  layer-norm-backward-bf16:
    <<: *layer-norm-backward
    pattern: layer-norm-backward-16
    symbol: mdl_layer_norm_backward_bf16
    applicability:
      dtype: { dy: bfloat16, gamma: bfloat16, xhat: bfloat16, var: bfloat16 }
      layout: { dy: row-major, xhat: row-major, var: row-major }
      where:
        - "$xhat.shape == $dy.shape"
        - "$gamma.shape == $dy.shape[-1:]"
        - "prod($var.shape) == prod($dy.shape[:-1])"
  layer-norm-backward-f16:
    <<: *layer-norm-backward
    pattern: layer-norm-backward-16
    symbol: mdl_layer_norm_backward_f16
    applicability:
      dtype: { dy: float16, gamma: float16, xhat: float16, var: float16 }
      layout: { dy: row-major, xhat: row-major, var: row-major }
      where:
        - "$xhat.shape == $dy.shape"
        - "$gamma.shape == $dy.shape[-1:]"
        - "prod($var.shape) == prod($dy.shape[:-1])"
