{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "conf-common",
            "description": "General settings that apply to all configurations",
            "hidden": true
        },
        {
            "name": "conf-release-common",
            "description": "General settings that apply to all configurations",
            "hidden": true,
            "inherits": "conf-common",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "conf-release-static-deps",
            "description": "Settings for building compiler with statically linked dependencies",
            "inherits": "conf-release-common",
            "cacheVariables": {
                "BUILD_SHARED_LIBS": "OFF",
                "MDL_BUILD_EXAMPLES": "ON",
                "MDL_BUILD_TESTS": "ON"
            }
        },
        {
            "name": "conf-tooling",
            "description": "Only the frontend and the tooling (mdl-format, mdls): no TVM/LLVM/oneDNN",
            "inherits": "conf-release-common",
            "cacheVariables": {
                "BUILD_SHARED_LIBS": "OFF",
                "MDL_ENABLE_COMPILER": "OFF",
                "MDL_BUILD_TESTS": "ON"
            }
        },
        {
            "name": "conf-docs",
            "description": "Only the documentation (target mdl_docs): the frontend and mdl-doc, no TVM/LLVM/oneDNN",
            "inherits": "conf-release-common",
            "cacheVariables": {
                "BUILD_SHARED_LIBS": "OFF",
                "MDL_ENABLE_COMPILER": "OFF",
                "MDL_BUILD_TESTS": "OFF",
                "MDL_BUILD_EXAMPLES": "OFF",
                "MDL_BUILD_DOCS": "ON"
            },
            "binaryDir": "${sourceDir}/build/docs"
        },
        {
            "name": "conf-dev",
            "description": "Settings for development",
            "inherits": "conf-common",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "BUILD_SHARED_LIBS": "OFF",
                "MDL_BUILD_EXAMPLES": "ON",
                "MDL_BUILD_TESTS": "ON"
            }
        }
    ],
    "testPresets": [
        {
            "name": "conf-tests",
            "description": "",
            "configurePreset": "conf-dev"
        }
    ],
    "buildPresets": [
        {
            "name": "docs",
            "description": "Builds the documentation",
            "configurePreset": "conf-docs",
            "targets": [
                "mdl_docs"
            ]
        }
    ],
    "workflowPresets": [
        {
            "name": "docs",
            "description": "Configures and builds the documentation",
            "steps": [
                {
                    "type": "configure",
                    "name": "conf-docs"
                },
                {
                    "type": "build",
                    "name": "docs"
                }
            ]
        }
    ]
}
