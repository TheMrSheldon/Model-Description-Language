#ifndef MDL_VERSION_HPP
#define MDL_VERSION_HPP

// Generated by CMake from the latest git tag (`git describe --tags`, e.g. 1.2.3 or 1.2.3-4-gabcdef0-dirty).

namespace mdl {
	inline constexpr int versionMajor = @MDL_VER_MAJOR@;
	inline constexpr int versionMinor = @MDL_VER_MINOR@;
	inline constexpr int versionPatch = @MDL_VER_PATCH@;
	/** @brief The full version, with the commits since the tag and `-dirty` for uncommitted changes. */
	inline constexpr const char* version = "@MDL_VER_MAJOR@.@MDL_VER_MINOR@.@MDL_VER_PATCH@@MDL_VER_META@";
} // namespace mdl

#endif
